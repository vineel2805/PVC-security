<?php

declare(strict_types=1);

/**
 * Catalog search — single source of truth for suggest API, overlay, and listing.
 *
 * Pipeline: normalize → tokenize → resolve brands/categories in memory →
 * one AND-of-token candidate query → field-aware scoring → rank.
 *
 * IDs (pid, brandid, cid) are strings. No product/brand/category names are hard-coded.
 */

function pvc_search_config(): array
{
    static $config = null;

    if ($config !== null) {
        return $config;
    }

    $config = [
        'max_query_length' => 80,
        'max_tokens'       => 8,
        'candidate_limit'  => 250,
        'suggest_products' => 8,
        'suggest_brands'   => 5,
        'suggest_categories' => 5,
        'listing_limit'    => 200,
        'stopwords'        => [
            'a' => true, 'an' => true, 'the' => true, 'of' => true,
            'for' => true, 'and' => true, 'or' => true, 'with' => true,
            'to' => true, 'in' => true, 'on' => true,
        ],
        'score' => [
            'exact_model'     => 50000,
            'exact_name'      => 40000,
            'pid_exact'       => 38000,
            'phrase_name'     => 8000,
            'all_tokens'      => 4500,
            'name_exact'      => 2400,
            'name_prefix'     => 1200,
            'name_partial'    => 220,
            'model_prefix'    => 4200,
            'model_partial'   => 350,
            'brand_exact'     => 1600,
            'brand_prefix'    => 800,
            'category_exact'  => 1500,
            'category_prefix' => 750,
            'pid_partial'     => 600,
            'description'     => 35,
            'shorter_name'    => 80,
        ],
    ];

    return $config;
}

function pvc_search_normalize(string $query): string
{
    $query = html_entity_decode($query, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $query = str_replace(["\r", "\n", "\t"], ' ', $query);
    $query = preg_replace('/[\x00-\x1F\x7F]/u', ' ', $query) ?? '';
    $query = mb_strtolower($query, 'UTF-8');
    $query = preg_replace('/[^\p{L}\p{N}\s._\/-]/u', ' ', $query) ?? '';
    $query = preg_replace('/\s+/u', ' ', $query) ?? '';
    $query = trim($query);

    $max = (int) pvc_search_config()['max_query_length'];
    if (mb_strlen($query, 'UTF-8') > $max) {
        $query = trim(mb_substr($query, 0, $max, 'UTF-8'));
    }

    return $query;
}

function pvc_search_rank_text(string $value): string
{
    $value = html_entity_decode($value, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $value = strip_tags($value);
    $value = str_replace(["\r", "\n", "\t"], ' ', $value);
    $value = mb_strtolower($value, 'UTF-8');
    $value = preg_replace('/\s+/u', ' ', $value) ?? '';

    return trim($value);
}

function pvc_search_compact(string $value): string
{
    return preg_replace('/[^\p{L}\p{N}]/u', '', pvc_search_rank_text($value)) ?? '';
}

function pvc_search_word_tokens(string $value): array
{
    $value = pvc_search_rank_text($value);
    if ($value === '') {
        return [];
    }

    $parts = preg_split('/[\s._\/-]+/u', $value, -1, PREG_SPLIT_NO_EMPTY);

    return $parts ? array_values(array_unique($parts)) : [];
}

function pvc_search_token_aliases(string $token): array
{
    $token = pvc_search_rank_text($token);
    if ($token === '') {
        return [];
    }

    $aliases = [$token];
    $compact = pvc_search_compact($token);
    if ($compact !== '' && $compact !== $token) {
        $aliases[] = $compact;
    }

    return array_values(array_unique($aliases));
}

function pvc_search_tokens(string $normalized): array
{
    if ($normalized === '') {
        return [];
    }

    $parts = preg_split('/\s+/u', $normalized, -1, PREG_SPLIT_NO_EMPTY);
    if (!$parts) {
        return [];
    }

    $stop = pvc_search_config()['stopwords'];
    $tokens = [];

    foreach ($parts as $token) {
        $token = trim($token);
        if ($token === '' || isset($stop[$token])) {
            continue;
        }

        $len = mb_strlen($token, 'UTF-8');
        $isDigit = (bool) preg_match('/^\d+$/u', $token);

        if ($len < 2 && !$isDigit) {
            continue;
        }

        $tokens[] = $token;
    }

    $tokens = array_values(array_unique($tokens));

    return array_slice($tokens, 0, (int) pvc_search_config()['max_tokens']);
}

function pvc_search_is_model_token(string $token): bool
{
    return preg_match('/\p{L}/u', $token) === 1
        && preg_match('/\d/u', $token) === 1;
}

function pvc_search_detect_intent(string $normalized, array $tokens): array
{
    $modelTokens = array_values(array_filter($tokens, 'pvc_search_is_model_token'));

    if ($normalized === '' || $tokens === []) {
        $type = 'empty';
    } elseif ($modelTokens !== []) {
        $type = 'product_code';
    } elseif (count($tokens) === 1) {
        $type = 'single_term';
    } else {
        $type = 'multi_term';
    }

    return [
        'type'        => $type,
        'has_model'   => $modelTokens !== [],
        'token_count' => count($tokens),
        'model_tokens'=> $modelTokens,
    ];
}

function pvc_search_like_pattern(string $token): string
{
    $escaped = str_replace(['\\', '%', '_'], ['\\\\', '\\%', '\\_'], $token);

    return '%' . $escaped . '%';
}

function pvc_search_public_image(?string $path): string
{
    $path = trim((string) $path);
    if ($path === '') {
        return '';
    }

    while (strpos($path, '../') === 0) {
        $path = substr($path, 3);
    }

    return $path;
}

function pvc_search_fetch_all(mysqli $con, string $sql, string $types = '', array $params = []): array
{
    $stmt = mysqli_prepare($con, $sql);
    if (!$stmt) {
        error_log('PVC search prepare failed: ' . mysqli_error($con));
        return [];
    }

    if ($types !== '') {
        mysqli_stmt_bind_param($stmt, $types, ...$params);
    }

    if (!mysqli_stmt_execute($stmt)) {
        error_log('PVC search execute failed: ' . mysqli_stmt_error($stmt));
        mysqli_stmt_close($stmt);
        return [];
    }

    $result = mysqli_stmt_get_result($stmt);
    if (!$result) {
        mysqli_stmt_close($stmt);
        return [];
    }

    $rows = [];
    while ($row = mysqli_fetch_assoc($result)) {
        $rows[] = $row;
    }

    mysqli_stmt_close($stmt);

    return $rows;
}

/**
 * @return 'exact'|'prefix'|'partial'|'none'
 */
function pvc_search_field_match(string $token, string $text): string
{
    $token = pvc_search_rank_text($token);
    $text = pvc_search_rank_text($text);

    if ($token === '' || $text === '') {
        return 'none';
    }

    $tokenLen = mb_strlen($token, 'UTF-8');
    $isShortDigit = $tokenLen === 1 && ctype_digit($token);
    $aliases = pvc_search_token_aliases($token);
    $words = pvc_search_word_tokens($text);

    if (in_array($text, $aliases, true)) {
        return 'exact';
    }

    foreach ($words as $word) {
        $wordCompact = pvc_search_compact($word);
        foreach ($aliases as $alias) {
            if ($word === $alias || $wordCompact === pvc_search_compact($alias)) {
                return 'exact';
            }
        }
    }

    $minPrefix = $isShortDigit ? 1 : 2;

    foreach ($words as $word) {
        $wordCompact = pvc_search_compact($word);
        foreach ($aliases as $alias) {
            $aliasLen = mb_strlen($alias, 'UTF-8');
            if ($aliasLen < $minPrefix) {
                continue;
            }
            if (strpos($word, $alias) === 0 || strpos($wordCompact, pvc_search_compact($alias)) === 0) {
                return 'prefix';
            }
        }
    }

    if ($isShortDigit) {
        return 'none';
    }

    foreach ($aliases as $alias) {
        if (mb_strlen($alias, 'UTF-8') >= 2 && strpos($text, $alias) !== false) {
            return 'partial';
        }
    }

    $tokenCompact = pvc_search_compact($token);
    $textCompact = pvc_search_compact($text);
    if (
        mb_strlen($tokenCompact, 'UTF-8') >= 3
        && str_contains($textCompact, $tokenCompact)
    ) {
        return 'partial';
    }

    return 'none';
}

function pvc_search_model_match(string $token, string $name, string $pid): string
{
    $token = pvc_search_compact($token);
    if ($token === '') {
        return 'none';
    }

    $name = pvc_search_compact($name);
    $pid = pvc_search_compact($pid);

    if ($token === $name || $token === $pid) {
        return 'exact';
    }

    if (str_starts_with($name, $token) || str_starts_with($pid, $token)) {
        return 'prefix';
    }

    $tokenLen = mb_strlen($token, 'UTF-8');
    if ($tokenLen >= 4 && (str_contains($name, $token) || str_contains($pid, $token))) {
        return 'partial';
    }

    return 'none';
}

function pvc_search_token_hit(string $token, array $fields): bool
{
    foreach (['name', 'brand', 'category', 'pid'] as $key) {
        if (pvc_search_field_match($token, $fields[$key]) !== 'none') {
            return true;
        }
    }

    if (pvc_search_model_match($token, $fields['name'], $fields['pid']) !== 'none') {
        return true;
    }

    return pvc_search_field_match($token, $fields['description']) !== 'none';
}

function pvc_search_entity_match_rank(array $tokens, string $name): int
{
    $name = pvc_search_rank_text($name);
    if ($name === '' || $tokens === []) {
        return 0;
    }

    $words = pvc_search_word_tokens($name);
    $best = 0;
    $matched = 0;

    foreach ($tokens as $token) {
        $kind = pvc_search_field_match($token, $name);
        if ($kind === 'none') {
            continue;
        }

        $tokenLen = mb_strlen($token, 'UTF-8');
        $allowWeakPrefix = false;

        if ($kind === 'prefix' && $tokenLen < 3) {
            foreach ($words as $word) {
                if (
                    str_starts_with($word, $token)
                    && mb_strlen($word, 'UTF-8') <= 4
                ) {
                    $allowWeakPrefix = true;
                    break;
                }
            }
            if (!$allowWeakPrefix && $name !== $token && !str_starts_with($name, $token)) {
                continue;
            }
        }

        $matched++;
        if ($kind === 'exact') {
    $score = 100;
} elseif ($kind === 'prefix') {
    $score = 70;
} elseif ($kind === 'partial') {
    $score = 25;
} else {
    $score = 0;
}
    }

    if ($matched === 0) {
        return 0;
    }

    if ($matched === count($tokens)) {
        $best += 40;
    }

    if (pvc_search_rank_text(implode(' ', $tokens)) === $name) {
        $best += 80;
    }

    return $best;
}

function pvc_search_load_brands(mysqli $con): array
{
    return pvc_search_fetch_all(
        $con,
        "SELECT brandid, brandname, COALESCE(imagelink, '') AS imagelink
         FROM brands
         WHERE display_status = 1"
    );
}

function pvc_search_load_categories(mysqli $con): array
{
    return pvc_search_fetch_all(
        $con,
        "SELECT cid, cname, brandid, COALESCE(cimage, '') AS cimage
         FROM category
         WHERE display_status = 1"
    );
}

function pvc_search_group_categories(array $rows): array
{
    $groups = [];

    foreach ($rows as $row) {
        $key = pvc_search_rank_text((string) ($row['cname'] ?? ''));
        if ($key === '') {
            continue;
        }

        if (!isset($groups[$key])) {
            $groups[$key] = [
                'cname'  => (string) $row['cname'],
                'cimage' => (string) ($row['cimage'] ?? ''),
                'cid'    => (string) ($row['cid'] ?? ''),
            ];
        }
    }

    return array_values($groups);
}

function pvc_search_resolve_entities(mysqli $con, array $tokens): array
{
    $brands = [];
    $categories = [];

    if ($tokens === []) {
        return ['brands' => [], 'categories' => []];
    }

    foreach (pvc_search_load_brands($con) as $row) {
        $rank = pvc_search_entity_match_rank($tokens, (string) $row['brandname']);
        if ($rank <= 0) {
            continue;
        }

        $brands[] = [
            'brandid'   => (string) $row['brandid'],
            'brandname' => trim((string) $row['brandname']),
            'imagelink' => pvc_search_public_image($row['imagelink'] ?? ''),
            '_score'    => $rank,
        ];
    }

    usort($brands, static function (array $a, array $b): int {
        if ($a['_score'] !== $b['_score']) {
            return $b['_score'] <=> $a['_score'];
        }

        return strcasecmp($a['brandname'], $b['brandname']);
    });

    foreach (pvc_search_group_categories(pvc_search_load_categories($con)) as $row) {
        $rank = pvc_search_entity_match_rank($tokens, (string) $row['cname']);
        if ($rank <= 0) {
            continue;
        }

        $categories[] = [
            'cid'    => (string) $row['cid'],
            'cname'  => (string) $row['cname'],
            'cimage' => pvc_search_public_image($row['cimage'] ?? ''),
            '_score' => $rank,
        ];
    }

    usort($categories, static function (array $a, array $b): int {
        if ($a['_score'] !== $b['_score']) {
            return $b['_score'] <=> $a['_score'];
        }

        return strcasecmp($a['cname'], $b['cname']);
    });

    $config = pvc_search_config();

    return [
        'brands'     => array_slice($brands, 0, (int) $config['suggest_brands']),
        'categories' => array_slice($categories, 0, (int) $config['suggest_categories']),
    ];
}

function pvc_search_product_select_sql(): string
{
    return "
        SELECT
            p.pid,
            p.pname,
            p.pdescription,
            p.pimage,
            p.brandid,
            p.pcat,
            p.status,
            p.status AS product_stock_status,
            COALESCE(b.brandname, '') AS brandname,
            COALESCE(b.brandname, '') AS brand_display,
            b.status AS brand_stock_status,
            COALESCE(c.cname, '') AS catname,
            COALESCE(c.cname, '') AS cat_display,
            c.status AS cat_stock_status
        FROM products p
        INNER JOIN brands b ON b.brandid = p.brandid
        INNER JOIN category c ON c.cid = p.pcat
        WHERE p.display_status = 1
          AND b.display_status = 1
          AND c.display_status = 1
    ";
}

function pvc_search_product_candidates(mysqli $con, array $tokens): array
{
    if ($tokens === []) {
        return [];
    }

    $limit = (int) pvc_search_config()['candidate_limit'];
    $conditions = [];
    $params = [];
    $types = '';

    foreach ($tokens as $token) {
        $pattern = pvc_search_like_pattern($token);
        $compact = pvc_search_compact($token);
        $useCompact = mb_strlen($compact, 'UTF-8') >= 4;

        $piece = "
            p.pname LIKE ? ESCAPE '\\\\'
            OR p.pid LIKE ? ESCAPE '\\\\'
            OR p.pdescription LIKE ? ESCAPE '\\\\'
            OR b.brandname LIKE ? ESCAPE '\\\\'
            OR c.cname LIKE ? ESCAPE '\\\\'
        ";
        $params[] = $pattern;
        $params[] = $pattern;
        $params[] = $pattern;
        $params[] = $pattern;
        $params[] = $pattern;
        $types .= 'sssss';

        if ($useCompact) {
            $piece .= "
                OR REPLACE(REPLACE(REPLACE(REPLACE(LOWER(p.pname), '-', ''), ' ', ''), '_', ''), '/', '')
                    LIKE ? ESCAPE '\\\\'
                OR REPLACE(REPLACE(REPLACE(REPLACE(LOWER(p.pid), '-', ''), ' ', ''), '_', ''), '/', '')
                    LIKE ? ESCAPE '\\\\'
            ";
            $compactPattern = pvc_search_like_pattern($compact);
            $params[] = $compactPattern;
            $params[] = $compactPattern;
            $types .= 'ss';
        }

        $conditions[] = '(' . $piece . ')';
    }

    $sql = pvc_search_product_select_sql()
        . ' AND ' . implode(' AND ', $conditions)
        . ' ORDER BY p.pname ASC, p.pid ASC LIMIT ?';

    $params[] = $limit;
    $types .= 'i';

    return pvc_search_fetch_all($con, $sql, $types, $params);
}

function pvc_search_analyze_match(array $product, array $tokens, string $normalized): array
{
    $fields = [
        'name'        => pvc_search_rank_text((string) ($product['pname'] ?? '')),
        'description' => pvc_search_rank_text((string) ($product['pdescription'] ?? '')),
        'brand'       => pvc_search_rank_text((string) ($product['brandname'] ?? '')),
        'category'    => pvc_search_rank_text((string) ($product['catname'] ?? '')),
        'pid'         => pvc_search_rank_text((string) ($product['pid'] ?? '')),
    ];

    $match = [
        'exact_model'            => pvc_search_model_match($normalized, $fields['name'], $fields['pid']) === 'exact',
        'exact_name'             => $fields['name'] !== '' && $fields['name'] === $normalized,
        'pid_exact'              => $fields['pid'] !== '' && $fields['pid'] === $normalized,
        'phrase_name'            => $normalized !== '' && str_contains($fields['name'], $normalized),
        'matched_tokens'         => 0,
        'name_exact_tokens'      => 0,
        'name_prefix_tokens'     => 0,
        'name_partial_tokens'    => 0,
        'brand_exact_tokens'     => 0,
        'brand_prefix_tokens'    => 0,
        'category_exact_tokens'  => 0,
        'category_prefix_tokens' => 0,
        'description_tokens'     => 0,
        'model_prefix_tokens'    => 0,
        'model_partial_tokens'   => 0,
        'pid_partial_tokens'     => 0,
        'name_len'               => mb_strlen($fields['name'], 'UTF-8'),
    ];

    foreach ($tokens as $token) {
        if (!pvc_search_token_hit($token, $fields)) {
            continue;
        }

        $match['matched_tokens']++;

        $nameMatch = pvc_search_field_match($token, $fields['name']);
        if ($nameMatch === 'exact') {
            $match['name_exact_tokens']++;
        } elseif ($nameMatch === 'prefix') {
            $match['name_prefix_tokens']++;
        } elseif ($nameMatch === 'partial') {
            $match['name_partial_tokens']++;
        }

        $brandMatch = pvc_search_field_match($token, $fields['brand']);
        if ($brandMatch === 'exact') {
            $match['brand_exact_tokens']++;
        } elseif ($brandMatch === 'prefix') {
            $match['brand_prefix_tokens']++;
        }

        $categoryMatch = pvc_search_field_match($token, $fields['category']);
        if ($categoryMatch === 'exact') {
            $match['category_exact_tokens']++;
        } elseif ($categoryMatch === 'prefix') {
            $match['category_prefix_tokens']++;
        }

        if (pvc_search_field_match($token, $fields['description']) !== 'none') {
            $match['description_tokens']++;
        }

        $modelMatch = pvc_search_model_match($token, $fields['name'], $fields['pid']);
        if ($modelMatch === 'prefix') {
            $match['model_prefix_tokens']++;
        } elseif ($modelMatch === 'partial') {
            $match['model_partial_tokens']++;
        }

        $pidMatch = pvc_search_field_match($token, $fields['pid']);
        if ($pidMatch !== 'none' && $pidMatch !== 'exact') {
            $match['pid_partial_tokens']++;
        }
    }

    return $match;
}

function pvc_search_product_score(array $product, array $tokens, string $normalized): int
{
    $weights = pvc_search_config()['score'];
    $match = pvc_search_analyze_match($product, $tokens, $normalized);
    $tokenCount = count($tokens);

    if ($tokenCount === 0 || $match['matched_tokens'] < $tokenCount) {
        return 0;
    }

    if ($match['exact_model']) {
        return (int) $weights['exact_model'];
    }
    if ($match['pid_exact']) {
        return (int) $weights['pid_exact'];
    }
    if ($match['exact_name']) {
        return (int) $weights['exact_name'];
    }

    $score = (int) $weights['all_tokens'];

    if ($match['phrase_name']) {
        $score += (int) $weights['phrase_name'];
    }

    $score += $match['name_exact_tokens'] * $weights['name_exact'];
    $score += $match['name_prefix_tokens'] * $weights['name_prefix'];
    $score += $match['name_partial_tokens'] * $weights['name_partial'];
    $score += $match['model_prefix_tokens'] * $weights['model_prefix'];
    $score += $match['model_partial_tokens'] * $weights['model_partial'];
    $score += $match['brand_exact_tokens'] * $weights['brand_exact'];
    $score += $match['brand_prefix_tokens'] * $weights['brand_prefix'];
    $score += $match['category_exact_tokens'] * $weights['category_exact'];
    $score += $match['category_prefix_tokens'] * $weights['category_prefix'];
    $score += $match['description_tokens'] * $weights['description'];
    $score += $match['pid_partial_tokens'] * $weights['pid_partial'];

    $nameHits = $match['name_exact_tokens'] + $match['name_prefix_tokens'] + $match['model_prefix_tokens'];
    if ($nameHits === 0 && $match['brand_exact_tokens'] > 0 && $tokenCount > 1) {
        $score = (int) round($score * 0.55);
    }

    if ($match['name_len'] > 0 && $match['name_len'] < 48 && $nameHits > 0) {
        $score += (int) $weights['shorter_name'];
    }

    return max(0, $score);
}

function pvc_search_rank_products(array $products, array $tokens, string $normalized, int $limit): array
{
    foreach ($products as &$product) {
        $product['_score'] = pvc_search_product_score($product, $tokens, $normalized);
        $product['_match'] = pvc_search_analyze_match($product, $tokens, $normalized);
    }
    unset($product);

    $products = array_values(array_filter(
    $products,
    static function (array $product): bool {
        return (int) ($product['_score'] ?? 0) > 0;
    }
));

    usort($products, static function (array $a, array $b): int {
        $score = ((int) $b['_score']) <=> ((int) $a['_score']);
        if ($score !== 0) {
            return $score;
        }

        $nameHitsA = (int) ($a['_match']['name_exact_tokens'] ?? 0)
            + (int) ($a['_match']['name_prefix_tokens'] ?? 0);
        $nameHitsB = (int) ($b['_match']['name_exact_tokens'] ?? 0)
            + (int) ($b['_match']['name_prefix_tokens'] ?? 0);
        if ($nameHitsA !== $nameHitsB) {
            return $nameHitsB <=> $nameHitsA;
        }

        $nameCmp = strcasecmp((string) ($a['pname'] ?? ''), (string) ($b['pname'] ?? ''));
        if ($nameCmp !== 0) {
            return $nameCmp;
        }

        return strcasecmp((string) ($a['pid'] ?? ''), (string) ($b['pid'] ?? ''));
    });

    foreach ($products as &$product) {
        unset($product['_match']);
    }
    unset($product);

    return array_slice($products, 0, $limit);
}

/**
 * @param array{product_limit?:int} $options
 */
function pvc_search(mysqli $con, string $query, array $options = []): array
{
    $config = pvc_search_config();
    $normalized = pvc_search_normalize($query);
    $tokens = pvc_search_tokens($normalized);
    $intent = pvc_search_detect_intent($normalized, $tokens);
    $limit = (int) ($options['product_limit'] ?? $config['listing_limit']);

    $empty = [
        'query'      => $query,
        'normalized' => $normalized,
        'tokens'     => $tokens,
        'intent'     => $intent,
        'entities'   => ['brands' => [], 'categories' => []],
        'products'   => [],
    ];

    if ($tokens === []) {
        return $empty;
    }

    $entities = pvc_search_resolve_entities($con, $tokens);
    $candidates = pvc_search_product_candidates($con, $tokens);
    $products = pvc_search_rank_products($candidates, $tokens, $normalized, $limit);

    return [
        'query'      => $query,
        'normalized' => $normalized,
        'tokens'     => $tokens,
        'intent'     => $intent,
        'entities'   => $entities,
        'products'   => $products,
    ];
}

function pvc_search_product_sublabel(array $product): string
{
    $brand = trim((string) ($product['brandname'] ?? ''));
    $cat = trim((string) ($product['catname'] ?? ''));

    if ($brand !== '' && $cat !== '') {
        return $brand . ' • ' . $cat;
    }

    return $brand !== '' ? $brand : $cat;
}

/**
 * Flat items consumed by the live overlay.
 */
function pvc_search_suggest_items(mysqli $con, string $query): array
{
    $config = pvc_search_config();
    $result = pvc_search($con, $query, [
        'product_limit' => (int) $config['suggest_products'],
    ]);

    $items = [];

    foreach ($result['entities']['brands'] as $brand) {
        $items[] = [
            'type'     => 'brand',
            'label'    => (string) $brand['brandname'],
            'sublabel' => 'Brand',
            'price'    => '',
            'pimage'   => (string) ($brand['imagelink'] ?? ''),
            'url'      => 'all-products.php?brand=' . rawurlencode((string) $brand['brandid']),
        ];
    }

    foreach ($result['entities']['categories'] as $category) {
        $items[] = [
            'type'     => 'category',
            'label'    => (string) $category['cname'],
            'sublabel' => 'Category',
            'price'    => '',
            'pimage'   => (string) ($category['cimage'] ?? ''),
            'url'      => 'all-categories.php?catname=' . rawurlencode((string) $category['cname']),
        ];
    }

    foreach ($result['products'] as $product) {
        $items[] = [
            'type'     => 'product',
            'label'    => (string) $product['pname'],
            'sublabel' => pvc_search_product_sublabel($product),
            'price'    => '',
            'pimage'   => pvc_search_public_image($product['pimage'] ?? ''),
            'url'      => 'all-products.php?pid=' . rawurlencode((string) $product['pid']),
        ];
    }

    return $items;
}
